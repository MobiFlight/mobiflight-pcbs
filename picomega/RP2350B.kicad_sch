	(text "Small footprint for C6\nand C7 MUST be used!"
		(exclude_from_sim no)
		(at 178.054 89.408 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0f19f6d0-51a5-480e-8f86-5c16187fdf7c")
	)
	(text "USB and power"
		(exclude_from_sim no)
		(at 37.084 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "147fb502-20a0-49b7-a0b1-61772069371f")
	)
	(text "If there are stability issues then R2 may need to be replaced\nwith a smaller value resistor. See \nhttps://forums.raspberrypi.com/viewtopic.php?t=336663 for more details."
		(exclude_from_sim no)
		(at 29.083 142.113 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "16f30e63-3408-4107-be4b-e49fbd5e2e8c")
	)
	(text "On a 1mm thick board, if we use 0.8mm wide tracks\non USB_DP and USB_DM, with a gap of 0.15mm between them,\nwe should get a differential characteristic impedance of\naround 90Ω as required for USB.\nOn a 1,6mm board 1mm tracks with a gap of 0.2mm is around 90Ohm."
		(exclude_from_sim no)
		(at 76.962 234.188 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "452adfd4-3d34-4d42-ac62-5f31fce55148")
	)
	(text "Make sure C19 is close\nto pin 59 of RP2350A"
		(exclude_from_sim no)
		(at 305.054 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6f73a106-e6f9-4505-a0b5-cc0af3c9f3ed")
	)
	(text "VERY IMPORTANT!"
		(exclude_from_sim no)
		(at 191.516 63.754 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9aaa3999-93fa-45ed-8857-7d4c577d936e")
	)
	(text "For RP2350 its not so important to get the correct\nimpedance as USB2.1 isn't very high clock rate.\nUsing 0.6mm track width and keeping some gap will work."
		(exclude_from_sim no)
		(at 76.962 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9ca3abde-c8fb-45d2-9e32-e573f95e0180")
	)
	(text "Crystal"
		(exclude_from_sim no)
		(at 29.337 107.569 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c12ba9b5-f444-41ac-bb58-154d63e7799e")
	)
